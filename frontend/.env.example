# ==============================================================================
# AquaRegen Frontend Environment Configuration (for Render / Vercel / Netlify)
# ==============================================================================

# URL of your deployed FastAPI Backend on Render (include /api)
# Example: https://aquaregen-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# Hardware Prototype Demonstration (Wokwi & Video)
# Optional: Hosted MP4 URL, local public asset path (e.g. /hardware-demo.mp4), or YouTube/Vimeo embed URL
VITE_AQUAREGEN_HARDWARE_VIDEO_URL=

# Optional: Shareable Wokwi simulation project URL
# Example: https://wokwi.com/projects/your-project-id
VITE_AQUAREGEN_WOKWI_URL=
